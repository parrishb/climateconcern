annotate(geom="text",x=1.1,y=-.76,label=round(cor(us.nat$mean,us.nat$mean.std,use="complete.obs"),2),
color="blue")+
labs(x="Global climate concern (US)",y="US climate concern\n(Bergquist and Warshaw 2019)")+
